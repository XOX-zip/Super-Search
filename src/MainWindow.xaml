<Window x:Class="SuperSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SS — Super Search"
        Width="980" Height="640" MinWidth="840" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 结果条目 -->
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2C4270" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultTemplate">
            <Border Padding="14,11">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Background="{StaticResource ChipBgBrush}" CornerRadius="5"
                                Padding="7,2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Host}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        </Border>
                        <TextBlock Text="{Binding ScoreText}" FontSize="11"
                                   Foreground="{StaticResource AccentTextBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ScoreVisibility}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Snippet}" Margin="0,6,0,0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" LineHeight="18" MaxHeight="38"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Background="{StaticResource AppBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="18,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5B8CFF" Offset="0" />
                                <GradientStop Color="#8A5BFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="S" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Super Search" FontSize="14" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Background="{StaticResource ChipBgBrush}" CornerRadius="5"
                            Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SS" FontSize="10" Foreground="{StaticResource FaintBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="AiPill" CornerRadius="12" Background="{StaticResource ChipBgBrush}"
                            Padding="10,5" Margin="0,0,8,0" Cursor="Hand"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseLeftButtonUp="AiPill_MouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AiDot" Width="6" Height="6" Fill="{StaticResource FaintBrush}"
                                     Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="AiPillText" Text="本地算法" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource IconButton}" Click="Settings_Click"
                            ToolTip="设置"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE713;" FontSize="15" />
                    </Button>

                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;"
                            Click="Min_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource WindowButton}" Click="Max_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaxIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- 搜索区 -->
            <Border Grid.Row="1" Margin="18,0,18,14" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14" BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <TextBox x:Name="QueryBox" Style="{StaticResource InputBox}"
                                     FontSize="16" Height="46" Padding="14,0"
                                     KeyDown="QueryBox_KeyDown" />
                            <TextBlock Text="搜索网页，或输入关键词开始侦查…" IsHitTestVisible="False"
                                       Foreground="{StaticResource FaintBrush}" Margin="15,0,0,0"
                                       VerticalAlignment="Center" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Width="108" Height="46" Margin="10,0,0,0" Click="SearchButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE721;"
                                           FontSize="13" Foreground="#FFFFFF" Margin="0,0,8,0" />
                                <TextBlock x:Name="SearchLabel" Text="搜索" Foreground="#FFFFFF"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="条数" Foreground="{StaticResource FaintBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="2,0,8,0" />
                        <TextBox x:Name="LimitBox" Style="{StaticResource InputBox}" Width="58"
                                 Height="32" Padding="8,0" TextAlignment="Center" />

                        <TextBlock Text="站点" Foreground="{StaticResource FaintBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="18,0,8,0" />
                        <Grid>
                            <TextBox x:Name="SiteBox" Style="{StaticResource InputBox}" Width="168"
                                     Height="32" Padding="10,0" />
                            <TextBlock Text="域名，如 github.com" IsHitTestVisible="False"
                                       Foreground="{StaticResource FaintBrush}" FontSize="11.5"
                                       Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SiteBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <CheckBox x:Name="AiToggle" Style="{StaticResource ChipToggle}"
                                  Content="用 AI 筛选" IsChecked="True"
                                  Margin="18,0,0,0" VerticalAlignment="Center" />
                        <CheckBox x:Name="VerboseToggle" Style="{StaticResource ChipToggle}"
                                  Content="显示评分" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Checked="VerboseToggle_Changed" Unchecked="VerboseToggle_Changed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Row="2" Margin="18,0,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <TextBlock Text="搜索结果" FontWeight="SemiBold" />
                        <TextBlock x:Name="CountText" HorizontalAlignment="Right"
                                   Foreground="{StaticResource FaintBrush}" FontSize="12"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ResultItemStyle}"
                                 ItemTemplate="{StaticResource ResultTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 SelectionChanged="ResultsList_SelectionChanged"
                                 MouseDoubleClick="ResultsList_MouseDoubleClick" />

                        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE721;"
                                       FontSize="30" Foreground="{StaticResource BorderBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyTitle" Text="输入关键词开始搜索" FontSize="15"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock x:Name="EmptyDesc"
                                       Text="结果会先经本地评分，接入 AI 后还会再做一次精筛。"
                                       Foreground="{StaticResource FaintBrush}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="330" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                        Padding="18">
                    <Grid>
                        <TextBlock x:Name="DetailEmpty" Text="选中一条结果查看详情"
                                   Foreground="{StaticResource FaintBrush}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ScrollViewer x:Name="DetailBody" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap" LineHeight="23" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Background="{StaticResource ChipBgBrush}" CornerRadius="5"
                                            Padding="7,2">
                                        <TextBlock x:Name="DetailHost" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                    <TextBlock x:Name="DetailScore" FontSize="11"
                                               Foreground="{StaticResource AccentTextBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="DetailUrl" Margin="0,12,0,0" FontSize="12"
                                           Foreground="{StaticResource AccentTextBrush}"
                                           TextWrapping="Wrap" />
                                <Border Height="1" Background="{StaticResource BorderSoftBrush}"
                                        Margin="0,14" />
                                <TextBlock x:Name="DetailSnippet" FontSize="12.5"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" LineHeight="20" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="16,8"
                                            Content="打开链接" Click="DetailOpen_Click" />
                                    <Button Style="{StaticResource GhostButton}" Padding="14,8"
                                            Margin="8,0,0,0" Content="复制链接"
                                            Click="DetailCopy_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 状态栏 -->
            <Border Grid.Row="3" Background="#0A0D12" BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0" Padding="18,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="BusyDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                 Visibility="Collapsed" Opacity="0.4" Margin="0,0,10,0" />
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource FaintBrush}"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="Enter 搜索 · Ctrl+F 聚焦 · Esc 取消"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource FaintBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
