<Window x:Class="SuperSearch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SS — 设置"
        Width="660" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Background="{StaticResource AppBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="20,0,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="设置" FontSize="14" FontWeight="SemiBold" />
                    <Border Background="{StaticResource ChipBgBrush}" CornerRadius="5"
                            Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SS" FontSize="10" Foreground="{StaticResource FaintBrush}" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CloseButton}" Height="48"
                        Content="&#xE8BB;" Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" Margin="24,8,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="FirstRunBanner" Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="10" Padding="14,12" Margin="0,0,0,18"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="首次运行 · 先配置一下" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentTextBrush}" />
                        <TextBlock Text="AI 是可选的：不填也能用，只是相关度排序会糙一些。之后可以随时回来改。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="AI 接入（可选）" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="兼容 OpenAI 的 /chat/completions 接口。三项留空 = 只用本地算法；填了地址和 Key 即启用 AI 精筛。"
                           Style="{StaticResource HintText}" Margin="0,0,0,14" />

                <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="EpBox" Style="{StaticResource InputBox}" Height="38" />
                <TextBlock Text="例：https://api.openai.com/v1" Style="{StaticResource HintText}"
                           Margin="2,6,0,14" />

                <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="KeyBox" Style="{StaticResource PasswordInput}"
                             Margin="0,0,0,14" />

                <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ModelBox" Style="{StaticResource InputBox}" Height="38" />
                <TextBlock Text="模型留空时默认 gpt-4o-mini。Key 以明文保存在本机配置文件中。"
                           Style="{StaticResource HintText}" Margin="2,6,0,0" />

                <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,18" />

                <TextBlock Text="搜索" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="默认条数" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LimitBox" Style="{StaticResource InputBox}" Width="80"
                                 Height="36" Padding="8,0" TextAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="1–50，搜索条数留空时用它" Style="{StaticResource HintText}"
                               VerticalAlignment="Bottom" Margin="12,0,0,9" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0"
                    Padding="24,14" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConfigPathText" Text="" Foreground="{StaticResource FaintBrush}"
                                   FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TestButton" Style="{StaticResource GhostButton}"
                                Content="测试连接" Click="Test_Click" />
                        <Button x:Name="SkipButton" Style="{StaticResource GhostButton}"
                                Content="只用本地算法" Margin="8,0,0,0" Click="Skip_Click"
                                Visibility="Collapsed" />
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}"
                                Content="保存" Margin="8,0,0,0" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
